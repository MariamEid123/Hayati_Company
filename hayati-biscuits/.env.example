# ══════════════════════════════════════════
# Hayati Biscuits – Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ══════════════════════════════════════════

NODE_ENV=development
PORT=3000

# Admin credentials (change these before going live!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HayatiAdmin2024!

# JWT secret – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret_here

# Cookie security
COOKIE_SECRET=CHANGE_ME_another_random_secret

# CORS – set to your actual domain in production
ALLOWED_ORIGIN=http://localhost:3000

# Session timeout (seconds) – default 8 hours
SESSION_TTL=28800

# WhatsApp number for orders (include country code, no +)
WHATSAPP_NUMBER=201227977347

# Data directory (defaults to ./data)
DATA_DIR=./data
